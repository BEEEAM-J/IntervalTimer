<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 러닝 중 화면이 꺼지거나 앱이 백그라운드로 가도 위치를 계속 받기 위한 포그라운드 Service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- 기록 중 알림. Android 13 부터 런타임 권한이며, 거부해도 Service 는 돌지만 알림이 보이지 않는다. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".IntervalTimerApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.IntervalTimer">

        <!-- MAPS_API_KEY 는 Secrets Gradle Plugin 이 local.properties 에서 읽어 넣는다. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <!-- 운동 중 휴대폰을 세로로 들고 쓰는 앱이라 가로 화면 UI 는 지원하지 않는다. -->
        <!-- Android 16 부터 큰 화면(태블릿·폴더블)에서는 이 고정이 무시되므로, 가로로 표시돼도 깨지지 않게 그린다. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- RunningTracker 가 기록을 시작할 때 띄우고, 기록이 끝나면 스스로 종료한다. -->
        <service
            android:name=".tracking.LocationTrackingService"
            android:exported="false"
            android:foregroundServiceType="location" />
    </application>

</manifest>
